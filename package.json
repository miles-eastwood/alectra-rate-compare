{
  "name": "alectra-calc",
  "displayName": "Alectra Rate Compare (Unofficial)",
  "version": "1.0.0",
  "author": "miles-eastwood",
  "description": "Compare Alectra electricity usage costs under tiered and time-of-use pricing.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "chrome-extension",
    "vue",
    "vite",
    "alectra"
  ],
  "engines": {
    "node": ">=14.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "fmt": "prettier --write '**/*.{vue,ts,json,css,scss,md}'",
    "zip": "npm run build && node src/zip.js"
  },
  "dependencies": {
    "vue": "^3.3.4"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.26",
    "@types/chrome": "^0.2.9",
    "@vitejs/plugin-vue": "^4.4.0",
    "gulp": "^5.0.0",
    "gulp-zip": "^6.0.0",
    "prettier": "^3.0.3",
    "typescript": "^5.9.3",
    "vite": "^5.4.10",
    "vue-tsc": "^2.1.10"
  }
}
